{
  "schemaVersion": 1,
  "locale": "ru",
  "sourceCatalog": "ui/src/i18n/locales/en.json",
  "targetCatalog": "ui/src/i18n/locales/ru.json",
  "scanRoots": ["ui/src", "packages/shared/src/constants.ts"],
  "excludedSources": [],
  "dynamicKeys": [
    {
      "file": "ui/src/pages/Auth.tsx",
      "owner": "AuthPage",
      "expression": "error.key",
      "keys": ["auth.errors.authenticationFailed", "auth.errors.requiredFields"],
      "reason": "Local sign-in error is a closed discriminated union; provider diagnostics are displayed separately."
    },
    {
      "file": "ui/src/pages/ProfileSettings.tsx",
      "owner": "ProfileSettings",
      "expression": "actionError.key",
      "keys": ["profile.updateFailed", "profile.selectOrganization", "profile.uploadFailed", "profile.removeFailed"],
      "reason": "Profile action errors are a closed union of four localized messages."
    }
  ]
}
